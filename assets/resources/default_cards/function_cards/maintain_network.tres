[ext_resource type="Script" path="res://assets/scripts/function_card.gd" id="1_p2bk3"]

[resource]
script = ExtResource("1_p2bk3")
card_name = "Maintain Network"
card_description = "Must execute immediately when drawn. Must discard 1 card from hand if total cards in Network (including Base card) is 5 cards or fewer, 2 cards if Network is 6 cards or more. Discard any Action card or cards from Network if no cards in hand. After discarding card(s), may rearrange up to all Action cards in own Network; they retain their revealed/concealed status."
card_image = ExtResource("1_baibv")
